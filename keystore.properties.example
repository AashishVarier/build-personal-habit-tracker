# Release signing configuration.
#
# Copy this file to keystore.properties (which is git-ignored) and fill in your own values.
# Never commit keystore.properties or the keystore file itself.
# Alternatively, set the environment variables named in brackets instead of using this file.

# Path to the keystore, relative to the project root or absolute.   [HABIT_TRACKER_STORE_FILE]
storeFile=release-keystore.jks
# Keystore password.                                                [HABIT_TRACKER_STORE_PASSWORD]
storePassword=CHANGE_ME
# Key alias inside the keystore.                                    [HABIT_TRACKER_KEY_ALIAS]
keyAlias=habittracker
# Key password.                                                     [HABIT_TRACKER_KEY_PASSWORD]
keyPassword=CHANGE_ME

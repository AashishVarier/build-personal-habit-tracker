<?xml version="1.0" encoding="utf-8"?>
<!-- Android Auto Backup (Android 11 and lower): the Room database and the settings.
     Each rule needs all of its flags, so there are two sets: cloud backups only when they are
     end-to-end encrypted (Android 9+ with a screen lock), and direct device-to-device transfers.
     "adb backup" has neither flag, so it can't extract the data. Android 8.x ignores requireFlags
     and backs up as before. -->
<full-backup-content>
    <include domain="database" path="habit_tracker.db" requireFlags="clientSideEncryption" />
    <include domain="database" path="habit_tracker.db-wal" requireFlags="clientSideEncryption" />
    <include domain="database" path="habit_tracker.db-shm" requireFlags="clientSideEncryption" />
    <include domain="file" path="datastore/settings.preferences_pb" requireFlags="clientSideEncryption" />

    <include domain="database" path="habit_tracker.db" requireFlags="deviceToDeviceTransfer" />
    <include domain="database" path="habit_tracker.db-wal" requireFlags="deviceToDeviceTransfer" />
    <include domain="database" path="habit_tracker.db-shm" requireFlags="deviceToDeviceTransfer" />
    <include domain="file" path="datastore/settings.preferences_pb" requireFlags="deviceToDeviceTransfer" />
</full-backup-content>

<?xml version="1.0" encoding="utf-8"?>
<!-- Android Auto Backup (Android 12 and higher): the Room database and the settings. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="habit_tracker.db" />
        <include domain="database" path="habit_tracker.db-wal" />
        <include domain="database" path="habit_tracker.db-shm" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="habit_tracker.db" />
        <include domain="database" path="habit_tracker.db-wal" />
        <include domain="database" path="habit_tracker.db-shm" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
